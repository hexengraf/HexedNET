simulated function ValidateNETClockPointer()
{
    if (NETClock == None)
    {
        ForEach DynamicActors(class'HxNTClock', NETClock) break;
    }
}

function DisableNet()
{
    if (FireMode[0] != None)
    {
        FireMode[0].SetPropertyText("bUseEnhancedNetCode", "false");
        FireMode[0].SetPropertyText("PingDT", "0.00");
    }
    if (FireMode[1] != None)
    {
        FireMode[1].SetPropertyText("bUseEnhancedNetCode", "false");
        FireMode[1].SetPropertyText("PingDT", "0.00");
    }
}
