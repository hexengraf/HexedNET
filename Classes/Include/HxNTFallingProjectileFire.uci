var protected const class<Weapon> WeaponClass;
var protected const class<Projectile> DummyProjectileClass;
var protected const class<Projectile> ExtrapolatedProjectileClass;

#include Classes\Include\HxNTBaseProjectileFire.uci

function DoFireEffect()
{
    DoBaseFireEffect();
}

function Projectile SpawnHexedProjectile(Vector Start, Rotator Dir, optional int Index)
{
    local Projectile P;

    if (Level.NetMode == NM_Client)
    {
        ProjectileClass = DummyProjectileClass;
        P = SpawnProjectile(Start, Dir);
        ProjectileClass = default.ProjectileClass;
        return Client.TrackDummyProjectile(P, WeaponClass);
    }
    if (WantsPingCompensation())
    {
        ProjectileClass = ExtrapolatedProjectileClass;
        P = SpawnProjectile(Start, Dir);
        ProjectileClass = default.ProjectileClass;
        HexedNET.ExtrapolateFallingProjectile(Weapon, P, Client.GetProjectilePing() + ServerDelay);
        return P;
    }
    return SpawnProjectile(Start, Dir);
}
