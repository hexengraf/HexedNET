simulated event NewNet_ClientStartFire(int Mode)
{
    if (!ValidateClient())
    {
        Super.ClientStartFire(Mode);
    }
    else if (Role < ROLE_Authority)
    {
        if (StartFire(Mode))
        {
            NewNet_ServerStartFire(Mode, Client.AveragePing);
        }
    }
    else
    {
        StartFire(Mode);
    }
}
