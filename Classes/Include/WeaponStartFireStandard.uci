simulated event NewNet_ClientStartFire(int Mode)
{
    if (Role < ROLE_Authority)
    {
        if (StartFire(Mode))
        {
            ValidateNETClockPointer();
            NewNet_ServerStartFire(Mode, class'HxNTClient'.default.AveragePing);
        }
    }
    else
    {
        StartFire(Mode);
    }
}
