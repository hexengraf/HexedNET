var float ServerDelay;
var private const float BASLocationTolerance;
var private const float BASAngleTolerance;
var private const bool bClientFireEffect;
var private MutHexedNET HexedNET;
var private HxNTClient Client;
var private Vector BASStart;
var private Rotator BASAim;
var private bool bHasNETWeapon;
var private bool bUseBAS;
var private Actor ClientHit;

function PreBeginPlay()
{
    Super.PreBeginPlay();
    class'HxNTWeapon'.static.ValidateClient(Level, HexedNET, Instigator, Client);
}

function bool WantsLagCompensation()
{
    return class'HxNTWeapon'.static.ValidateClient(Level, HexedNET, Instigator, Client)
        && Client.WantsLagCompensation();
}

function int ApplyBAS(HxNTWeapon.HxBAS BAS, optional out Actor Hit)
{
    local Rotator CurrentAim;
    local Vector CurrentStart;
    local Vector HitLocation;
    local Vector HitNormal;
    local Vector Diff;

    if (class'HxNTWeapon'.static.ValidateClient(Level, HexedNET, Instigator, Client))
    {
        class'HxNTWeapon'.static.DecodeBAS(BAS, BASStart, BASAim);
        if (Weapon.Role < ROLE_Authority)
        {
            if (Client.WantsClientSideCollision())
            {
                Hit = Weapon.Trace(
                    HitLocation, HitNormal, BASStart + Vector(BASAim) * TraceRange, BASStart, true);
            }
            bUseBAS = true;
            if (bClientFireEffect)
            {
                bHasNETWeapon = true;
                DoFireEffect();
            }
            return Client.GetStopFireTickCount();
        }
        ClientHit = Hit;
        GetStartAndAim(CurrentStart, CurrentAim);
        Diff = BASStart - CurrentStart;
        bUseBAS = (Diff dot Diff) < BASLocationTolerance
            && Vector(BASAim) dot Vector(CurrentAim) > BASAngleTolerance;
    }
    return 0;
}

function PlayFiring()
{
    Super.PlayFiring();
    if (Level.NetMode == NM_Client && bClientFireEffect && !bHasNETWeapon
        && Instigator.IsLocallyControlled() && WantsLagCompensation())
    {
        DoFireEffect();
    }
}

function DoFireEffect()
{
    if (bUseBAS)
    {
        Instigator.MakeNoise(1.0);
        DoTrace(BASStart, BASAim);
        bUseBAS = false;
    }
    else
    {
        Super.DoFireEffect();
    }
    ServerDelay = 0;
}
