var const bool bClientFireEffect;
var bool bEarlyFireEffect;
var float RTTDeviation;
var private MutHexedNET HexedNET;
var private HxNTClient Client;
var private Vector BASStart;
var private Rotator BASAim;
var private bool bUseBAS;
var private Actor ClientHit;
var private bool bDoRecon;
var private const class<Weapon> WeaponClass;
var private HxNTWeaponInfo WeaponInfo;

function PreBeginPlay()
{
    Super.PreBeginPlay();
    class'HxNTWeapon'.static.ValidateClient(Level, Instigator, Client, HexedNET);
}

function bool WantsLagCompensation()
{
    return class'HxNTWeapon'.static.ValidateClient(Level, Instigator, Client, HexedNET)
        && Client.WantsLagCompensation();
}

function bool PrepareBAS(out HxNTWeapon.HxBAS BAS, out int StopTime, optional out Actor Hit)
{
    local Vector HitLocation;
    local Vector HitNormal;
    local bool bUseCSC;

    GetStartAndAim(BASStart, BASAim);
    BAS.X = BASStart.X;
    BAS.Y = BASStart.Y;
    BAS.Z = BASStart.Z;
    BAS.Yaw = BASAim.Yaw;
    BAS.Pitch = BASAim.Pitch;
    BAS.Timestamp = Client.GetReferenceTimestamp();
    WeaponInfo = Client.SynchronizeRandomness(WeaponClass, BAS.Timestamp);
    if (Client.WantsClientSideCollision())
    {
        Hit = Weapon.Trace(
            HitLocation, HitNormal, BASStart + Vector(BASAim) * TraceRange, BASStart, true);
        bUseCSC = true;
    }
    bUseBAS = true;
    bEarlyFireEffect = true;
    DoFireEffect();
    StopTime = Client.GetStopFireTickCount();
    return bUseCSC;
}

function ApplyBAS(HxNTWeapon.HxBAS BAS, optional Actor Hit, optional bool bHasHit)
{
    local Rotator CurrentAim;
    local Vector CurrentStart;

    if (class'HxNTWeapon'.static.ValidateClient(Level, Instigator, Client, HexedNET))
    {
        BASStart.X = BAS.X;
        BASStart.Y = BAS.Y;
        BASStart.Z = BAS.Z;
        BASAim.Yaw = BAS.Yaw;
        BASAim.Pitch = BAS.Pitch;
        WeaponInfo = Client.SynchronizeRandomness(WeaponClass, BAS.Timestamp);
        ClientHit = Hit;
        bDoRecon = bHasHit;
        GetStartAndAim(CurrentStart, CurrentAim);
        BASAim.Roll = CurrentAim.Roll;
        bUseBAS = HexedNET.IsReasonableBAS(BASStart, BASAim, CurrentStart, CurrentAim);
        RTTDeviation = Client.GetRTTDeviation(Level.TimeSeconds - BAS.Timestamp);
    }
}

function SynchronizeFireTime(float MaxDelay)
{
    RTTDeviation = FMin(RTTDeviation, MaxDelay);
    if (MaxDelay > 0.0)
    {
        if (bServerDelayStartFire)
        {
            NextFireTime -= MaxDelay + 0.001;
            RTTDeviation = MaxDelay;
        }
        else if (RTTDeviation > 0.0)
        {
            NextFireTime -= RTTDeviation;
        }
    }
}

function PlayFiring()
{
    Super.PlayFiring();
    if (Level.NetMode == NM_Client && !bEarlyFireEffect && WantsLagCompensation())
    {
        DoFireEffect();
    }
    bEarlyFireEffect = false;
}

function DoFireEffect()
{
    if (WantsLagCompensation())
    {
        if (!bUseBAS)
        {
            GetStartAndAim(BASStart, BASAim);
        }
        BASAim = ApplySpread(Vector(BASAim));
        if (Level.NetMode != NM_Client || bClientFireEffect)
        {
            Instigator.MakeNoise(1.0);
            DoTrace(BASStart, BASAim);
        }
        bUseBAS = false;
    }
    else
    {
        Super.DoFireEffect();
    }
    RTTDeviation = 0;
}

final function float GetCompensationTime()
{
    return Client.GetCompensationTime() + RTTDeviation;
}
