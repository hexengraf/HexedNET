var bool bEarlyFireEffect;
var float RTTDeviation;
var private MutHexedNET HexedNET;
var private HxNTClient Client;
var private Vector BASStart;
var private Rotator BASAim;
var private float ProjectileDelayTimer;
var private bool bUseBAS;
var private bool bIsDelayed;
var private const class<Weapon> WeaponClass;
var private HxNTWeaponInfo WeaponInfo;

function PreBeginPlay()
{
    Super.PreBeginPlay();
    class'HxNTWeapon'.static.ValidateClient(Level, Instigator, Client, HexedNET);
}

function bool WantsLagCompensation()
{
    return class'HxNTWeapon'.static.ValidateClient(Level, Instigator, Client, HexedNET)
        && Client.WantsLagCompensation();
}

function float PrepareTimestamp()
{
    local float Timestamp;

    Timestamp = Client.GetReferenceTimestamp();
    WeaponInfo = Client.SynchronizeRandomness(WeaponClass, Timestamp);
    return Timestamp;
}

function ApplyTimestamp(float Timestamp)
{
    if (class'HxNTWeapon'.static.ValidateClient(Level, Instigator, Client, HexedNET))
    {
        WeaponInfo = Client.SynchronizeRandomness(WeaponClass, Timestamp);
    }
}

function PrepareBAS(out HxNTWeapon.HxBAS BAS, optional out int StopTime, optional bool bSkipSync)
{
    BASStart = Instigator.Location + Instigator.EyePosition();
    BASAim = AdjustAim(BASStart, AimError);
    BAS.X = BASStart.X;
    BAS.Y = BASStart.Y;
    BAS.Z = BASStart.Z;
    BAS.Yaw = BASAim.Yaw;
    BAS.Pitch = BASAim.Pitch;
    BAS.Timestamp = Client.GetReferenceTimestamp();
    if (!bSkipSync)
    {
        WeaponInfo = Client.SynchronizeRandomness(WeaponClass, BAS.Timestamp);
    }
    bUseBAS = true;
    bEarlyFireEffect = true;
    DoPredictedFireEffect();
    StopTime = Client.GetStopFireTickCount();
}

function ApplyBAS(HxNTWeapon.HxBAS BAS, optional bool bSkipSync)
{
    local Rotator CurrentAim;
    local Vector CurrentStart;

    if (class'HxNTWeapon'.static.ValidateClient(Level, Instigator, Client, HexedNET))
    {
        BASStart.X = BAS.X;
        BASStart.Y = BAS.Y;
        BASStart.Z = BAS.Z;
        BASAim.Yaw = BAS.Yaw;
        BASAim.Pitch = BAS.Pitch;
        if (!bSkipSync)
        {
            WeaponInfo = Client.SynchronizeRandomness(WeaponClass, BAS.Timestamp);
        }
        CurrentStart = Instigator.Location + Instigator.EyePosition();
        CurrentAim = AdjustAim(CurrentStart, AimError);
        BASAim.Roll = CurrentAim.Roll;
        bUseBAS = HexedNET.IsReasonableBAS(BASStart, BASAim, CurrentStart, CurrentAim);
        RTTDeviation = Client.GetRTTDeviation(Level.TimeSeconds - BAS.Timestamp);
    }
}

function SynchronizeFireTime(float MaxDelay)
{
    RTTDeviation = FMin(RTTDeviation, MaxDelay);
    if (MaxDelay > 0.0)
    {
        if (bServerDelayStartFire)
        {
            NextFireTime -= MaxDelay + 0.001;
            RTTDeviation = MaxDelay;
        }
        else if (RTTDeviation > 0.0)
        {
            NextFireTime -= RTTDeviation;
        }
    }
}

function PlayFiring()
{
    Super.PlayFiring();
    if (Level.NetMode == NM_Client && !bEarlyFireEffect && WantsLagCompensation())
    {
        DoPredictedFireEffect();
    }
    bEarlyFireEffect = false;
}

function DoPredictedFireEffect()
{
    local float ProjectileDelay;

    ProjectileDelay = Client.GetProjectileDelay();
    if (ProjectileDelay > 0)
    {
        if (ProjectileDelayTimer > 0)
        {
            DoFireEffect();
        }
        ProjectileDelayTimer = ProjectileDelay;
        if (!bUseBAS)
        {
            BASStart = Instigator.Location + Instigator.EyePosition();
            BASAim = AdjustAim(BASStart, AimError);
            bUseBAS = true;
        }
        SaveDelayedState();
        bIsDelayed = true;
    }
    else
    {
        DoFireEffect();
    }
}

event ModeTick(float DT)
{
    if (Level.NetMode == NM_Client && ProjectileDelayTimer > 0)
    {
        ProjectileDelayTimer -= DT;
        if (ProjectileDelayTimer <= 0)
        {
            DoFireEffect();
            bIsDelayed = false;
        }
    }
    Super.ModeTick(DT);
}

function GetProjectileStartAndDirection(out Vector Start,
                                        out Rotator Dir,
                                        optional out Vector X,
                                        optional out Vector Y,
                                        optional out Vector Z)
{
    local Vector HitLocation;
    local Vector HitNormal;

    if (bUseBAS)
    {
        bUseBAS = false;
        Dir = BASAim;
    }
    else
    {
        BASStart = Instigator.Location + Instigator.EyePosition();
        if (Instigator.Controller != None)
        {
            BASAim = Instigator.Controller.Rotation;
        }
        else
        {
            BASAim = Instigator.Rotation;
        }
        Dir = AdjustAim(Start, AimError);
    }
    GetAxes(BASAim, X, Y, Z);
    Start = BASStart + X * ProjSpawnOffset.X;
    if (!Weapon.WeaponCentered())
    {
        Start += Weapon.Hand * Y * ProjSpawnOffset.Y + Z * ProjSpawnOffset.Z;
    }
    if (Weapon.Trace(HitLocation, HitNormal, Start, BASStart, false) != None)
    {
        Start = HitLocation;
    }
}

function DoBaseFireEffect()
{
    local Vector Start;
    local Vector X;
    local Rotator Dir;
    local float Theta;
    local int SpawnCount;
    local int i;

    if (WantsLagCompensation())
    {
        Instigator.MakeNoise(1.0);
        GetProjectileStartAndDirection(Start, Dir);
        SpawnCount = Max(1, ProjPerFire * int(Load));
        switch (SpreadStyle)
        {
            case SS_Random:
                X = Vector(Dir);
                for (i = 0; i < SpawnCount; ++i)
                {
                    Dir.Yaw = Spread * (WeaponInfo.Generator.RandFloat() - 0.5);
                    Dir.Pitch = Spread * (WeaponInfo.Generator.RandFloat() - 0.5);
                    Dir.Roll = Spread * (WeaponInfo.Generator.RandFloat() - 0.5);
                    SpawnHexedProjectile(Start, Rotator(X >> Dir));
                }
                break;
            case SS_Line:
                for (i = 0; i < SpawnCount; ++i)
                {
                    Theta = Spread * PI / 32768 * (i - float(SpawnCount - 1) / 2.0);
                    X.X = Cos(Theta);
                    X.Y = Sin(Theta);
                    X.Z = 0.0;
                    SpawnHexedProjectile(Start, Rotator(X >> Dir));
                }
                break;
            default:
                SpawnHexedProjectile(Start, Dir);
                break;
        }
    }
    else
    {
        Super.DoFireEffect();
    }
    RTTDeviation = 0;
}

final function float GetCompensationTime()
{
    return Client.GetProjectileCompensationTime(bEarlyFireEffect) + RTTDeviation;
}
